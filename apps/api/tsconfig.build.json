{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * Pin the source root to src/. Without this, prisma.config.ts sitting at the
     * app root widens TypeScript's inferred rootDir to the whole package, and
     * the entrypoint is emitted at dist/src/main.js instead of dist/main.js —
     * breaking both `start:prod` and the CMD in docker/api.Dockerfile.
     */
    "rootDir": "src",
    /**
     * Keep the incremental cache INSIDE dist.
     *
     * nest-cli.json sets deleteOutDir: true. If the .tsbuildinfo lives outside
     * dist (which is where TypeScript puts it once rootDir is set explicitly),
     * nest deletes dist, tsc then reads the surviving cache, concludes nothing
     * changed, and emits no files — a successful-looking build that produces an
     * empty dist. Storing it here means the cache is discarded together with
     * the output it describes.
     */
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}
