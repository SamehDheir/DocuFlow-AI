# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment — never commit real secrets; .env.example is the tracked template
.env
.env.*
!.env.example

# Test / coverage
coverage/
.nyc_output/

# Prisma — generated client only; migrations MUST be committed
prisma/generated/
apps/*/prisma/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local infrastructure volumes (if bind-mounted instead of named volumes)
.docker-data/
docker/data/

# Uploaded files during local dev
uploads/
tmp/

# Claude Code local state. settings.json accumulates a machine-specific tool
# permission allowlist (absolute paths and all), so it is local noise rather
# than shared project config. Force-add it deliberately if you ever want to
# commit team-wide settings.
.claude/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Caches
.cache/
.turbo/
.eslintcache
