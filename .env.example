# ==============================================================================
# DocuFlow AI — environment template
#
#   cp .env.example .env
#
# The values below are DEVELOPMENT DEFAULTS and match docker-compose.yml, so a
# fresh clone starts with no edits. Every secret here is public knowledge by
# definition — regenerate all of them before any deployment reachable from a
# network you do not control.
#
# .env is gitignored. Keep it that way.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL
# Host ports are configurable so the stack does not collide with a Postgres or
# Redis you already run locally.
# ------------------------------------------------------------------------------
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=docuflow_dev_password
POSTGRES_DB=docuflow
POSTGRES_PORT=5432

# Consumed by Prisma. Host is `localhost` because the API runs on the host in
# development; inside the compose network it becomes `postgres`.
DATABASE_URL=postgresql://docuflow:docuflow_dev_password@localhost:5432/docuflow?schema=public

# ------------------------------------------------------------------------------
# Redis — BullMQ queues (OCR, AI, thumbnails) and session storage
# ------------------------------------------------------------------------------
REDIS_PASSWORD=docuflow_dev_password
REDIS_PORT=6379
REDIS_URL=redis://:docuflow_dev_password@localhost:6379

# ------------------------------------------------------------------------------
# MinIO — S3-compatible object storage for document bytes
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=docuflow
MINIO_ROOT_PASSWORD=docuflow_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=docuflow-documents

MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=docuflow
MINIO_SECRET_KEY=docuflow_dev_password

# ------------------------------------------------------------------------------
# Authentication
#
# Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Access and refresh secrets MUST differ. If they are the same, an access token
# is structurally valid as a refresh token, so a leaked short-lived token can be
# traded for indefinite session renewal.
# ------------------------------------------------------------------------------
JWT_SECRET=dev_only_replace_me_with_a_random_48_byte_secret
JWT_REFRESH_SECRET=dev_only_replace_me_with_a_different_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cost factor for password hashing. 12 is a reasonable production floor;
# lower it locally only if test suites become painfully slow.
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Application URLs
# NEXT_PUBLIC_* is inlined into the browser bundle at build time — never put a
# secret behind that prefix.
# ------------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Mirrors MAX_FILE_SIZE below. The browser checks the size BEFORE it starts
# sending: an over-limit upload is aborted by the server mid-stream, and the
# browser then reports ERR_CONNECTION_RESET rather than surfacing the 413.
NEXT_PUBLIC_MAX_FILE_SIZE=104857600
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# File upload limits
# Keep MAX_FILE_SIZE at or below nginx's client_max_body_size (docker/nginx/nginx.conf,
# currently 100m). If nginx is the stricter of the two it rejects the request
# before the API can return a useful validation error.
# ------------------------------------------------------------------------------
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain

# ------------------------------------------------------------------------------
# AI provider — powers OCR, summaries and keyword extraction (v2).
#
# Leave XAI_API_KEY blank and the API falls back to a deterministic stub
# provider: documents still move through the whole pipeline and every screen
# still renders, without spending a token. Set the key to run it for real.
#
# xAI speaks the OpenAI wire format, so no vendor SDK is installed.
# ------------------------------------------------------------------------------
AI_PROVIDER=groq

# --- Groq (default) -----------------------------------------------------------
# Mind the spelling: Groq is LPU inference over open models, and is NOT xAI's
# Grok below. Two models, because Groq's text models reject image input
# outright — only the Qwen multimodal model accepts it.
#
# Leave GROQ_VISION_MODEL blank to turn OCR of scans off while keeping summaries.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- xAI (Grok) ---------------------------------------------------------------
# One model handles both text and vision.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=

# No vision model reads PDFs directly, so a PDF's text layer is extracted
# locally (free, exact, zero API calls) and only a PDF with no text layer — a
# real scan — is rasterised into page images.
#
# AI_MAX_OCR_PAGES defaults low because free tiers are tight: Groq's allows
# 8,000 tokens a minute and one page image costs 1,200-3,000 of them. A higher
# cap does not read more pages, it just spends longer being rate limited.
AI_OCR_ENABLED=true
AI_MAX_OCR_PAGES=8
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_SUMMARY_CHARS=60000

# Documents processed concurrently per API instance.
QUEUE_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Embeddings — a dormant seam, deliberately.
#
# xAI publishes no embeddings endpoint, so semantic search cannot run on the
# same key as OCR. `document_metadata.embedding` exists at vector(1024) and
# stays NULL until one of these keys is set; search runs on Postgres full text
# and trigram matching until then, and switching over needs no migration.
#
# Mind the width: OpenAI's text-embedding-3-small is 1536 and will not fit the
# column. Use Voyage, or an OpenAI model reduced to 1024 dimensions.
# ------------------------------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3

# ------------------------------------------------------------------------------
# Email — defaults target the Mailpit container (`--profile mail`), which
# captures mail locally instead of delivering it.
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@docuflow.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------
# Optional dev tools (`--profile tools`)
# ------------------------------------------------------------------------------
ADMINER_PORT=8080

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
